Options -Indexes
<IfModule mod_rewrite.c>
 RewriteEngine On
 RewriteRule ^(app|config|database|routes|tools|tests|docs|storage)(/|$) - [F,L,NC]
 RewriteRule ^(\.git|\.gitignore|composer\.|README) - [F,L,NC]
 RewriteCond %{REQUEST_FILENAME} -f
 RewriteRule ^ - [L]
 RewriteRule ^.*$ public/index.php [QSA,L]
</IfModule>
